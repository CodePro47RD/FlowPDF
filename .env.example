# ==========================================
# ReportForge Docker Environment Configuration
# ==========================================

# Port Configuration
REPORTFORGE_PORT=8050
REPORTFORGE_GATEWAY_PORT=8090
REPORTFORGE_DB_PORT=5439
REPORTFORGE_REDIS_PORT=6379

# Django Security
SECRET_KEY=reportforge-super-secret-key-change-in-production
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:8050,http://127.0.0.1:8050,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000,http://localhost,http://127.0.0.1

# Database Configuration
DB_NAME=reportforge
DB_USER=postgres
DB_PASSWORD=reportforge_password
DB_HOST=db
DB_PORT=5432
