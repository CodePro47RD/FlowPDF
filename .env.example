# =============================================================================
# ReportForge Environment Configuration
# =============================================================================

# Django Security
SECRET_KEY=replace-with-a-very-strong-secret-key-in-production-1234567890
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.reportforge.io

# PostgreSQL Database
DB_NAME=reportforge
DB_USER=postgres
DB_PASSWORD=reportforge_password
DB_HOST=db
DB_PORT=5432

# Redis & Celery Task Queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage Provider (local | s3)
REPORTFORGE_STORAGE_BACKEND=local
REPORTFORGE_STORAGE_DIR=media/reports

# AWS S3 / MinIO Configuration (Required only when REPORTFORGE_STORAGE_BACKEND=s3)
AWS_STORAGE_BUCKET_NAME=reportforge-documents
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=miniopassword
AWS_S3_REGION_NAME=us-east-1
